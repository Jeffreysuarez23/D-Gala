<?php
require_once("include/db.php");
require_once("include/configuracionesAD.php");

$db = new Database();
$conexion = $db->getConexion();
  
// Obtener todos los productos (activos e inactivos) CON nombres de categorías
$sql = "SELECT p.id, p.titulo, p.descripcion, p.precio, p.descuento, p.stock, p.imagen, p.id_categoria, p.activo, p.fecha_publicacion, c.nombre as categoria_nombre 
        FROM productos p 
        LEFT JOIN caracteristicas c ON p.id_categoria = c.id 
        ORDER BY p.fecha_publicacion DESC";
$resultado = $conexion->query($sql);
$productos = $resultado->fetchAll(PDO::FETCH_ASSOC);

// Obtener todas las categorías activas
$sqlCategorias = "SELECT id, nombre FROM caracteristicas WHERE activo = 1 ORDER BY nombre";
$resultadoCategorias = $conexion->query($sqlCategorias);
$categorias = $resultadoCategorias->fetchAll(PDO::FETCH_ASSOC);



// Verificar si se ha enviado el formulario de edición
if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['accion']) && $_POST['accion'] == 'editar') {
    $id = $_POST['id'];
    $titulo = $_POST['titulo'];
    $descripcion = $_POST['descripcion'];
    $precio = $_POST['precio'];
    $descuento = $_POST['descuento'];
    $stock = $_POST['stock'];
    $categoria = $_POST['id_categoria'];
    $activo = $_POST['activo'];


    // Actualizar el producto
    $sqlActualizar = "UPDATE productos SET titulo = :titulo, descripcion = :descripcion, precio = :precio, descuento = :descuento, stock = :stock, id_categoria = :id_categoria, activo = :activo WHERE id = :id";
    $stmt = $conexion->prepare($sqlActualizar);
    $stmt->bindParam(':titulo', $titulo);
    $stmt->bindParam(':descripcion', $descripcion);
    $stmt->bindParam(':precio', $precio);
    $stmt->bindParam(':descuento', $descuento);
    $stmt->bindParam(':stock', $stock);
    $stmt->bindParam(':id_categoria', $categoria);
    $stmt->bindParam(':activo', $activo);
    $stmt->bindParam(':id', $id);
    if ($stmt->execute()) {
        echo "<script>alert('Producto actualizado exitosamente.'); window.location.replace('index.php?mod=GestionarProductos');</script>";
    }else{
        echo "<script>alert('Error al actualizar el producto.'); window.location.replace('index.php?mod=GestionarProductos');</script>";
    }
}

// Verificar si se ha enviado la solicitud para eliminar
if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['accion']) && $_POST['accion'] == 'eliminar') {
    $idEliminar = $_POST['id_eliminar'];
    
    try {
        $conexion->beginTransaction();
        
        // Eliminar primero las imágenes asociadas al producto
        $sqlEliminarImagenes = "DELETE FROM producto_imagenes WHERE producto_id = :id";
        $stmtImagenes = $conexion->prepare($sqlEliminarImagenes);
        $stmtImagenes->bindParam(':id', $idEliminar);
        $stmtImagenes->execute();
        
        // Luego eliminar el producto
        $sqlEliminar = "DELETE FROM productos WHERE id = :id";
        $stmtEliminar = $conexion->prepare($sqlEliminar);
        $stmtEliminar->bindParam(':id', $idEliminar);
        
        if ($stmtEliminar->execute()) {
            $conexion->commit();
            echo "<script>alert('Producto eliminado definitivamente de la base de datos.'); window.location.replace('index.php?mod=GestionarProductos');</script>";
        } else {
            $conexion->rollBack();
            echo "<script>alert('Error al eliminar el producto.'); window.location.replace('index.php?mod=GestionarProductos');</script>";
        }
    } catch (Exception $e) {
        $conexion->rollBack();
        echo "<script>alert('Error: " . $e->getMessage() . "'); window.location.replace('index.php?mod=GestionarProductos');</script>";
    }
}

